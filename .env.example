DATABASE_URL=postgresql://user:password@host:5432/v8exclusive
JWT_SECRET=troque-por-uma-string-longa-e-aleatoria-minimo-32-chars
NODE_ENV=development
PORT=3000

# URL base da API (usada nos callbacks OAuth)
API_URL=http://localhost:3000

# URL do frontend (redirecionamento após login social)
CLIENT_URL=http://localhost:5173

# ── Google OAuth ──────────────────────────────────────────────
# console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0
# Redirect URI: {API_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Facebook OAuth ────────────────────────────────────────────
# developers.facebook.com → My Apps → Facebook Login → Settings
# Redirect URI: {API_URL}/api/auth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ── Apple Sign In ─────────────────────────────────────────────
# developer.apple.com → Certificates → Sign in with Apple
# Requer: Team ID, Key ID e arquivo .p8
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# APPLE_PRIVATE_KEY_PATH=./keys/apple_auth.p8
